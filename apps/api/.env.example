# RentBook API Environment Configuration

PROJECT_NAME="RentBook API"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
# Minimum 32 characters, cryptographically random in production
SECRET_KEY="rentbook-dev-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentbook"

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8081"
